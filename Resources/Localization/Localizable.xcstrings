    "action.copySingle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select one clip to copy, or press Return to paste the selected clips in order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一项复制，或按 Return 按顺序粘贴所选项目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーする項目を1つ選択するか、Returnで選択項目を順にペーストします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Element zum Kopieren wählen oder Return drücken, um die Auswahl der Reihe nach einzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un élément à copier ou appuyez sur Retour pour coller la sélection dans l’ordre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un elemento para copiar o pulsa Intro para pegar la selección en orden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz element do skopiowania lub naciśnij Return, aby wkleić zaznaczenie po kolei."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取一項複製，或按 Return 依序貼上所選項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사할 항목 하나를 선택하거나 Return으로 선택 항목을 순서대로 붙여넣으세요."
          }
        }
      }
    },
    "action.writeFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not copy this clip. Its content or attachment may be unavailable. Restore the file, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法复制此项，内容或附件可能不可用。请恢复文件后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容または添付ファイルを利用できないためコピーできませんでした。ファイルを復元して再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de copier. Le contenu ou le fichier joint est peut-être indisponible. Restaurez le fichier et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren fehlgeschlagen. Inhalt oder Anhang möglicherweise nicht verfügbar. Datei wiederherstellen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo copiar. El contenido o archivo adjunto podría no estar disponible. Restaura el archivo y reintenta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się skopiować. Treść lub załącznik mogą być niedostępne. Przywróć plik i spróbuj ponownie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法複製此項，內容或附件可能無法使用。請復原檔案後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이나 첨부 파일을 사용할 수 없어 복사하지 못했습니다. 파일을 복원한 후 다시 시도하세요."
          }
        }
      }
    },
    "action.copiedManual": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied. Return to your app and press ⌘V. Enable Accessibility for direct paste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制。返回目标应用后按 ⌘V。开启辅助功能即可直接粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしました。対象アプリに戻って ⌘V を押してください。直接ペーストにはアクセシビリティを許可してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié. Revenez à votre app et appuyez sur ⌘V. Autorisez l’accessibilité pour coller directement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert. Zur Ziel-App zurückkehren und ⌘V drücken. Für direktes Einfügen Bedienungshilfen erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. Vuelve a tu app y pulsa ⌘V. Permite Accesibilidad para pegar directamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowano. Wróć do aplikacji i naciśnij ⌘V. Zezwól na dostęp do Ułatwień dostępu, aby wklejać bezpośrednio."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製。返回目標應用程式後按 ⌘V。開啟輔助使用即可直接貼上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사했습니다. 대상 앱으로 돌아가 ⌘V를 누르세요. 바로 붙여넣으려면 손쉬운 사용을 허용하세요."
          }
        }
      }
    },
