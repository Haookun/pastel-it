    "shortcuts.stackTutorialWithoutBinding": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Paste Stack from the menu. Copy several things, then ⌘V in the target app to paste them one by one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从菜单打开粘贴队列。连续复制多项后，在目标应用按 ⌘V 逐个粘贴。"
