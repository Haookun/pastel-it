            "state": "translated",
            "value": "未识别到文字，或内容不可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを認識できませんでした。コンテンツが利用できない可能性があります。"
          }
        },
        "fr": {
