    "languageRepair.missingMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The resources for your selected language are missing. The app will continue running in English. Your settings and history are not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面语言资源缺失，应用将继续使用英文运行。配置和剪贴板历史不受影响。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語リソースがありません。英語で引き続き使用できます。設定と履歴は保持されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ressources manquent. L’app continue en anglais. Réglages et historique sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App läuft auf Englisch weiter. Einstellungen und Verlauf bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app seguirá en inglés. Se conservan ajustes e historial."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja będzie działać po angielsku. Ustawienia i historia pozostają."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面語言資源缺失，應用程式將繼續以英文運作。設定和剪貼簿歷史不受影響。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 리소스가 없습니다. 영어로 계속 사용할 수 있으며 설정과 기록은 유지됩니다."
          }
