    "ocr.minimumHeight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum text height"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最小文字高度"
          }
        }
      }
    },
    "ocr.parametersHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text height is a fraction of image height; 0% keeps small text. Fast mode supports fewer languages; selected languages use accurate mode when needed. Document table detection uses its own system model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按图片高度的比例过滤文字；0% 保留小字。快速模式支持的语言较少，必要时为指定语言使用精确模式；表格检测使用独立的系统模型。"
          }
        }
      }
    },
    "ocr.reset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset OCR Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复 OCR 默认设置"
          }
        }
      }
    },
    "quickPaste.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Paste"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷粘贴"
          }
        }
      }
    },
    "quickPaste.enabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable quick paste"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用快捷粘贴"
          }
        }
      }
    },
    "quickPaste.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert the current system clipboard to plain text and paste it. Default: ⇧⌘V. Open clipboard history separately with ⇧⌘C."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前系统剪贴板转换为纯文本并粘贴，默认 ⇧⌘V。打开剪贴板的默认快捷键为 ⇧⌘C。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムクリップボードをプレーンテキストに変換してペーストします（⇧⌘V）。履歴を開く既定キーは⇧⌘Cです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Zwischenablage als reinen Text einfügen: ⇧⌘V. Verlauf öffnen: ⇧⌘C."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir le presse-papiers en texte brut et coller : ⇧⌘V. Ouvrir l’historique : ⇧⌘C."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte el portapapeles en texto sin formato y pega con ⇧⌘V. Abre el historial con ⇧⌘C."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej bieżący schowek jako zwykły tekst: ⇧⌘V. Otwórz historię: ⇧⌘C."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將目前系統剪貼簿轉為純文字並貼上，預設 ⇧⌘V。⇧⌘C 開啟剪貼簿。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 클립보드를 일반 텍스트로 변환하여 붙여넣습니다(⇧⌘V). 기록 열기 기본값은 ⇧⌘C입니다."
          }
        }
      }
    },
    "quickPaste.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text → plain text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字 → 纯文本"
          }
        }
      }
    },
    "quickPaste.images": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images → OCR text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片 → OCR 文字"
          }
        }
      }
    },
    "quickPaste.files": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files → file names"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件 → 文件名"
          }
        }
      }
    },
    "quickPaste.scopeHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only selected types are converted. Images follow the OCR settings on the OCR page. Without Accessibility, plain text is prepared for manual ⌘V. Automatic pasting restores the original clipboard unless you copy something newer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅转换勾选的类型。图片遵循“OCR”栏目的设置；无辅助功能权限时，先准备纯文本，再手动按 ⌘V。自动粘贴后恢复原剪贴板；期间复制了新内容则保留新内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只轉換勾選的類型。圖片依照「OCR」頁面的設定；未授權輔助使用時，先準備純文字，再手動按 ⌘V。自動貼上後會還原原剪貼簿，除非期間複製了新內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した種類のみ変換します。画像はOCRページの設定を使用します。権限がない場合は⌘Vで手動ペーストできます。自動ペースト後は、新しいコピーがない限り元の内容に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 유형만 변환합니다. 이미지는 OCR 페이지 설정을 따릅니다. 권한이 없으면 ⌘V로 직접 붙여넣습니다. 새로 복사한 내용이 없으면 자동 붙여넣기 후 원래 클립보드를 복원합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les types sélectionnés sont convertis. Les images utilisent la page OCR. Sans accessibilité, collez avec ⌘V. Le presse-papiers est restauré sauf si un nouvel élément a été copié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausgewählte Typen werden umgewandelt. Bilder nutzen die OCR-Seite. Ohne Bedienungshilfen manuell mit ⌘V einfügen. Die Zwischenablage wird wiederhergestellt, sofern nichts Neues kopiert wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se convierten los tipos seleccionados. Las imágenes usan la página OCR. Sin Accesibilidad, pega con ⌘V. El portapapeles se restaura salvo que copies algo nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konwertowane są tylko zaznaczone typy. Obrazy korzystają ze strony OCR. Bez Dostępności wklej ręcznie przez ⌘V. Schowek jest przywracany, chyba że skopiowano coś nowego."
          }
        }
      }
    },
    "quickPaste.emptyScope": {
      "localizations": {
