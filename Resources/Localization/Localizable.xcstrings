    "settings.aboutBlurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastel it！ is a local-first clipboard manager. History stays on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastel it！ 是一款本地优先的剪贴板管理器。历史记录仅保存在本 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastel it！ はローカル優先のクリップボードマネージャーです。履歴はこの Mac にのみ保存されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastel it！ est un gestionnaire de presse-papiers local. L'historique reste sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastel it！ ist ein lokaler Zwischenablage-Manager. Der Verlauf bleibt auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
