    "ocr.enabledHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognize new images in the background. Existing results are kept when OCR is off. Re-run an image to apply changed settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台识别新图片。关闭 OCR 不会删除已有结果；修改参数后，可对图片点击 Re-run 重新识别。"
          }
        }
      }
    },
