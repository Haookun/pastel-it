    "shortcuts.timelineFootnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open clipboard history with ⇧⌘C. Configure Quick Paste separately on the Quick Paste page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C 打开剪贴板；快捷粘贴在独立的“快捷粘贴”栏目中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C 開啟剪貼簿；快速貼上可在獨立的「快速貼上」頁面設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘Cで履歴を開きます。クイックペーストは専用ページで設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C로 기록을 엽니다. 빠른 붙여넣기는 별도 페이지에서 설정하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C ouvre l’historique. Le collage rapide se configure sur sa propre page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C öffnet den Verlauf. Schnelles Einfügen hat eine eigene Einstellungsseite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C abre el historial. El pegado rápido se configura en su propia página."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C otwiera historię. Szybkie wklejanie ma osobną stronę ustawień."
          }
        }
      }
    },
