    "action.multiPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Accessibility to paste multiple clips, or select one clip to copy manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请启用辅助功能以粘贴多项，或选择一项复制后手动粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数項目のペーストにはアクセシビリティを許可するか、1項目を選んで手動でコピー・ペーストしてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accessibilité pour coller plusieurs éléments, ou sélectionnez-en un pour le copier manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen für mehrere Einträge erlauben oder einen Eintrag zum manuellen Kopieren auswählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Accesibilidad para pegar varios elementos o selecciona uno para copiarlo manualmente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na Ułatwienia dostępu, aby wkleić wiele elementów, lub wybierz jeden do ręcznego skopiowania."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請啟用輔助使用以貼上多項，或選擇一項複製後手動貼上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 항목을 붙여넣으려면 손쉬운 사용을 허용하거나 항목 하나를 선택해 수동으로 복사하고 붙여넣으세요."
          }
        }
      }
    },
    "action.focusChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste stopped because the destination or permission changed. Focus your destination and try the remaining clips again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标应用或权限已变化，粘贴已停止。请聚焦目标位置后重试剩余项。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象アプリまたは権限が変わったため停止しました。対象にフォーカスして残りの項目を再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collage arrêté : la destination ou l’autorisation a changé. Activez la destination et réessayez les éléments restants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügen gestoppt: Ziel oder Berechtigung geändert. Ziel aktivieren und verbleibende Einträge erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegado detenido: cambió el destino o el permiso. Enfoca el destino e intenta pegar los elementos restantes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklejanie zatrzymane: zmienił się cel lub uprawnienie. Uaktywnij cel i spróbuj wkleić pozostałe elementy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標應用程式或權限已變更，貼上已停止。請聚焦目標位置後重試剩餘項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 앱이나 권한이 변경되어 중단했습니다. 대상에 포커스를 맞춘 후 나머지 항목을 다시 시도하세요."
          }
        }
      }
    },
