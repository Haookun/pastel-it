    "privacy.logs.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access the logs. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问日志，请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログにアクセスできません。再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès aux journaux impossible. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Protokolle fehlgeschlagen. Erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a los registros. Inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uzyskać dostępu do dzienników. Spróbuj ponownie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取日誌，請重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그에 접근할 수 없습니다. 다시 시도하세요."
          }
        }
      }
    },
    "privacy.logs.footerScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting only removes this app’s local log files. Settings, clipboard history, attachments, and macOS system logs are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清理本应用的本地日志，不删除配置、剪贴板历史、附件或 macOS 系统日志。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのローカルログのみ削除します。設定、履歴、添付ファイル、macOSシステムログは保持されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les journaux locaux de cette app sont effacés. Réglages, historique, pièces jointes et journaux macOS sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die lokalen Protokolle dieser App werden gelöscht. Einstellungen, Verlauf, Anhänge und macOS-Systemprotokolle bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se borran los registros locales de esta app. Se conservan ajustes, historial, adjuntos y registros del sistema macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwane są tylko lokalne dzienniki tej aplikacji. Ustawienia, historia, załączniki i dzienniki macOS pozostają."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅清理本應用的本機日誌，不刪除設定、剪貼簿歷史、附件或 macOS 系統日誌。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 로컬 로그만 삭제합니다. 설정, 기록, 첨부 파일과 macOS 시스템 로그는 유지됩니다."
          }
        }
      }
    },
