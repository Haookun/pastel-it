    "action.settingDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click, Return, and ⌘1–9 use the selected action. Direct Paste is the default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击、Return 和 ⌘1–9 统一执行所选操作，默认直接粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
