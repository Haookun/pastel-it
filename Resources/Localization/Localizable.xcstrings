    "action.permissionNeeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct paste needs Accessibility"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接粘贴需要辅助功能权限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接ペーストにはアクセシビリティが必要です"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le collage direct nécessite l’accessibilité"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktes Einfügen benötigt Bedienungshilfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pegado directo requiere Accesibilidad"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośrednie wklejanie wymaga Ułatwień dostępu"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接貼上需要輔助使用權限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 붙여넣기에 손쉬운 사용 권한이 필요합니다"
          }
        }
      }
    },
    "action.permissionDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility lets Pastel it！ send ⌘V to your destination app. You can still copy clips and paste them manually without granting access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能允许 Pastel it！ 向目标应用发送 ⌘V。未授权也可以复制内容后手动粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティを許可すると対象アプリに ⌘V を送信できます。許可しなくてもコピーして手動でペーストできます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accessibilité permet à Pastel it！ d’envoyer ⌘V à l’app cible. Sans autorisation, vous pouvez toujours copier et coller manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Bedienungshilfen kann Pastel it！ ⌘V an die Ziel-App senden. Ohne Erlaubnis können Sie weiterhin kopieren und manuell einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilidad permite a Pastel it！ enviar ⌘V a la app de destino. Sin permiso, puedes copiar y pegar manualmente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ułatwienia dostępu pozwalają Pastel it！ wysyłać ⌘V do aplikacji docelowej. Bez uprawnienia nadal możesz kopiować i wklejać ręcznie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用允許 Pastel it！ 向目標應用程式傳送 ⌘V。未授權也可以複製內容後手動貼上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용을 허용하면 Pastel it！이 대상 앱에 ⌘V를 보낼 수 있습니다. 허용하지 않아도 복사 후 수동으로 붙여넣을 수 있습니다."
          }
        }
      }
    },
    "removal.saveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the change. Your history has been restored; try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存更改，已恢复历史记录，请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存できませんでした。履歴を復元しました。再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer. L’historique a été restauré ; réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderung konnte nicht gespeichert werden. Verlauf wiederhergestellt; erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el cambio. Se restauró el historial; reintenta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać zmiany. Historia została przywrócona; spróbuj ponownie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存變更，已復原歷史記錄，請重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장하지 못해 기록을 복원했습니다. 다시 시도하세요."
          }
        }
      }
    },
    "action.tutorial": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a clip, ⌘C to copy, then ⌘V in your app. Choose Direct Paste in Settings for one-step reuse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中一项，按 ⌘C 复制，再到目标应用按 ⌘V。可在设置中选择直接粘贴以一步完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を選んで ⌘C でコピーし、対象アプリで ⌘V。設定で直接ペーストを選ぶと一度の操作で再利用できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un élément, ⌘C pour copier, puis ⌘V dans votre app. Choisissez Collage direct dans les réglages pour une seule action."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eintrag auswählen, mit ⌘C kopieren, dann in der Ziel-App ⌘V drücken. Für einen Schritt in den Einstellungen Direkt einfügen wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un elemento, copia con ⌘C y pulsa ⌘V en tu app. Elige Pegado directo en Ajustes para hacerlo en un paso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz element, skopiuj przez ⌘C i wklej przez ⌘V w aplikacji. Wybierz Bezpośrednie wklejanie w ustawieniach, aby zrobić to jednym krokiem."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取一項，按 ⌘C 複製，再到目標應用程式按 ⌘V。可在設定中選擇直接貼上以一步完成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 선택하고 ⌘C로 복사한 후 대상 앱에서 ⌘V를 누르세요. 설정에서 바로 붙여넣기를 선택하면 한 번에 재사용할 수 있습니다."
          }
        }
      }
    },
