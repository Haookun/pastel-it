    "privacy.logs.confirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only local diagnostic logs will be deleted. Settings, clipboard history, and attachments will be preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除本地诊断日志，配置、剪贴板历史和附件都会保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル診断ログのみ削除します。設定、クリップボード履歴、添付ファイルは保持されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les journaux locaux seront supprimés. Réglages, historique et pièces jointes seront conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur lokale Diagnoseprotokolle werden gelöscht. Einstellungen, Verlauf und Anhänge bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminan los registros locales. Se conservan los ajustes, el historial y los adjuntos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte zostaną tylko lokalne dzienniki. Ustawienia, historia i załączniki pozostaną."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅刪除本機診斷日誌，設定、剪貼簿歷史和附件均會保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 진단 로그만 삭제합니다. 설정, 클립보드 기록과 첨부 파일은 유지됩니다."
          }
        }
      }
    },
    "privacy.logs.deleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
