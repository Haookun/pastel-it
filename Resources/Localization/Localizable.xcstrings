    "clipboard.style.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab shows the next 10 clips in Candidate Bar. Both styles use the clipboard shortcut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选列表每页10条，Tab 翻页；两种样式共用打开快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選清單每頁10筆，Tab 翻頁；兩種樣式共用開啟快速鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補は1ページ10件。Tabで次のページへ進みます。開くショートカットは共通です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "후보는 페이지당 10개이며 Tab으로 넘깁니다. 같은 단축키로 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 éléments par page, Tab pour avancer. Le raccourci d’ouverture reste commun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "10 Einträge pro Seite, Tab blättert weiter. Beide Ansichten nutzen denselben Kurzbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "10 elementos por página; Tab avanza. Ambas vistas usan el mismo atajo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 pozycji na stronę; Tab przechodzi dalej. Oba widoki mają ten sam skrót."
          }
        }
      }
    },
