    "folders.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create up to %lld custom folders. They appear as tabs next to Default and Pinned. Clips in folders are kept when history is pruned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多创建 %lld 个自定义文件夹。它们会显示在「默认」和「已固定」旁的标签中。清理历史时文件夹中的剪贴项会保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムフォルダは最大 %lld 個。デフォルトとピン留めの隣のタブに表示されます。履歴整理時もフォルダ内の項目は保持されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez jusqu'à %lld dossiers personnalisés. Ils apparaissent à côté de Par défaut et Épinglés. Les éléments des dossiers sont conservés lors du nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %lld benutzerdefinierte Ordner. Sie erscheinen neben Standard und Angeheftet. Ordner-Einträge bleiben bei der Bereinigung erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea hasta %lld carpetas personalizadas. Aparecen junto a Predeterminado y Fijados. Los elementos en carpetas se conservan al limpiar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz do %lld własnych folderów. Pojawią się obok Domyślne i Przypięte. Elementy w folderach są zachowywane przy czyszczeniu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可建立 %lld 個自訂檔案夾，會顯示在「預設」與「已釘選」旁邊的標籤中。整理歷史記錄時，檔案夾中的項目會保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 폴더는 최대 %lld개까지 만들 수 있으며 기본 및 고정됨 옆 탭에 표시됩니다. 기록을 정리해도 폴더 안 항목은 유지됩니다."
          }
        }
      }
    },
