    "candidateBar.locationFallback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caret position unavailable. Showing near the pointer; Accessibility may be required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能获取插入光标位置，暂在鼠标旁显示；请检查辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得插入游標位置，暫在滑鼠旁顯示；請檢查輔助使用權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソル位置を取得できないため、ポインタ付近に表示します。アクセシビリティ権限をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 커서 위치를 가져올 수 없어 포인터 근처에 표시합니다. 손쉬운 사용 권한을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cursorposition nicht verfügbar. Anzeige am Mauszeiger; Bedienungshilfen prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position du curseur indisponible. Affichage près du pointeur ; vérifiez l’accessibilité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Posición del cursor no disponible. Se muestra junto al puntero; comprueba Accesibilidad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycja kursora niedostępna. Wyświetlanie przy wskaźniku; sprawdź dostępność."
          }
        }
      }
    },
