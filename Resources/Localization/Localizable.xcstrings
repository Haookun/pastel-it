    "languageRepair.privateHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repository is private or the file is unavailable. Sign in to GitHub in your browser, download this version’s language pack, then install the downloaded file. English remains available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库仍为私人或文件暂不可用。请在浏览器登录 GitHub，下载当前版本的语言包后导入安装。期间可继续使用英文界面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開リポジトリまたはファイルを取得できません。ブラウザでGitHubにログインし、このバージョンの言語パックを取得してインストールしてください。英語で引き続き使用できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt est privé ou le fichier indisponible. Connectez-vous à GitHub dans le navigateur, téléchargez le pack de cette version puis installez-le. L’anglais reste disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository privat oder Datei nicht verfügbar. Melden Sie sich im Browser bei GitHub an, laden Sie das Sprachpaket dieser Version und installieren Sie es. Englisch bleibt verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio es privado o el archivo no está disponible. Inicia sesión en GitHub en el navegador, descarga el paquete de esta versión e instálalo. El inglés sigue disponible."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozytorium jest prywatne lub plik niedostępny. Zaloguj się do GitHub w przeglądarce, pobierz pakiet tej wersji i go zainstaluj. Angielski pozostaje dostępny."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫仍為私人或檔案暫時無法使用。請在瀏覽器登入 GitHub，下載目前版本的語言包後匯入安裝。期間可繼續使用英文介面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 저장소이거나 파일에 접근할 수 없습니다. 브라우저에서 GitHub에 로그인하여 현재 버전의 언어 팩을 다운로드한 뒤 설치하세요. 영어로 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "languageRepair.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language pack is damaged or does not match this app version. Nothing was installed. Download the matching pack and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言包已损坏或与当前应用版本不匹配，未安装任何内容。请下载匹配的语言包后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語パックが破損しているか、このバージョンと一致しません。インストールしていません。正しいパックで再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pack endommagé ou incompatible. Rien n’a été installé. Téléchargez le pack correspondant et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachpaket beschädigt oder nicht passend. Es wurde nichts installiert. Laden Sie das passende Paket erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquete dañado o incompatible. No se instaló nada. Descarga el paquete correspondiente e inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiet uszkodzony lub niezgodny. Niczego nie zainstalowano. Pobierz właściwy pakiet i spróbuj ponownie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語言包已損壞或不符合目前應用程式版本，未安裝任何內容。請下載符合的語言包後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 팩이 손상되었거나 버전이 다릅니다. 아무것도 설치하지 않았습니다. 올바른 팩으로 다시 시도하세요."
          }
        }
      }
    },
    "languageRepair.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language resources could not be repaired. Check your connection or install a downloaded pack. Your settings and history are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法修复语言资源。请检查网络，或安装已下载的语言包。配置和历史保持不变。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語リソースを修復できません。接続を確認するか、取得済みのパックをインストールしてください。設定と履歴は保持されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réparation impossible. Vérifiez la connexion ou installez un pack téléchargé. Réglages et historique sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparatur fehlgeschlagen. Verbindung prüfen oder geladenes Paket installieren. Einstellungen und Verlauf bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reparar. Comprueba la conexión o instala un paquete descargado. Se conservan ajustes e historial."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprawa nie powiodła się. Sprawdź połączenie lub zainstaluj pobrany pakiet. Ustawienia i historia pozostają."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法修復語言資源。請檢查網路，或安裝已下載的語言包。設定和歷史保持不變。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
