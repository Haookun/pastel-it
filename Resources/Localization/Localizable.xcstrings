    "shortcuts.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a key with Command, Control, or Option. Standard editing and app commands are reserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 Command、Control 或 Option 加其他按键；常用编辑与应用快捷键不能覆盖。"
          }
        }
      }
    },
    "shortcuts.duplicate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut is already assigned to another action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷键已用于其他操作，请换一个组合。"
          }
        }
      }
    },
    "shortcuts.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not register this shortcut. It may be in use. Your previous shortcuts were kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法注册此快捷键，可能已被占用。已保留原快捷键。"
          }
        }
      }
    },
    "shortcuts.registrationFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some shortcuts could not be registered. Choose another combination; all actions remain available from the menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分快捷键注册失败，请更换组合。仍可从菜单使用所有功能。"
          }
        }
      }
    },
    "shortcuts.edit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to change this shortcut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击修改快捷键"
          }
        }
      }
    },
    "shortcuts.reset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset All Shortcuts to Defaults"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复所有默认快捷键"
          }
        }
      }
    },
    "shortcuts.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a shortcut, then press a new combination. Changes take effect immediately and are saved on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击快捷键后按下新的组合，修改立即生效，并会在重启后保留。"
          }
        }
      }
    },
    "shortcuts.recordTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change Shortcut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改快捷键"
          }
        }
      }
    },
    "shortcuts.recordHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a key with Command, Control, or Option. Press Backspace to clear, or Escape to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 Command、Control 或 Option 加其他按键。按退格键清除，按 Esc 取消。"
          }
        }
      }
    },
    "shortcuts.listening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for shortcut…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按下新的快捷键…"
          }
        }
      }
    },
    "shortcuts.plainFootnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plain-text shortcut pastes once without formatting, then restores the original clipboard (Accessibility required). In the timeline, ⇧↩ pastes the selection as plain text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯文本快捷键会按无格式文本粘贴一次，再还原原始剪贴板（需要辅助功能权限）。时间线中按 ⇧↩ 可粘贴所选纯文本。"
          }
        }
      }
    },
    "shortcuts.stackFootnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Paste Stack shortcut opens or closes the queue. While it has items, ⌘V in any app pastes the next one (Accessibility required)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队列快捷键用于打开或关闭粘贴队列。有待粘贴内容时，在目标应用按 ⌘V 可依次粘贴（需要辅助功能权限）。"
          }
        }
      }
    },
    "shortcuts.stackTutorial": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens a queue on the right. Copy several things, then ⌘V in the target app to paste them one by one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 打开右侧队列。连续复制多项后，在目标应用按 ⌘V 逐个粘贴。"
          }
        }
      }
    },
    "permissions.restartTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Pastel it！ After Granting Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权完成，请重启 Pastel it！"
          }
        }
      }
    },
    "permissions.restartDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is now enabled. Please quit and reopen Pastel it！ so automatic pasting and Paste Stack can use the updated permission. Your clipboard history will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限已开启。请退出并重新打开 Pastel it！，让自动粘贴和队列监听使用新权限。剪贴板历史会保留。"
          }
        }
      }
    },
    "permissions.restartHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission updated. Quit and reopen Pastel it！ to finish applying it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限已更新，请退出并重新打开 Pastel it！，使新权限完整生效。"
          }
        }
      }
    },
    "permissions.understood": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got It"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了"
          }
        }
      }
    },
    "shortcuts.unassigned": {
      "localizations": {
