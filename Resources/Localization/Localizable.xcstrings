    "onboarding.capture.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy anything — Pastel it！ saves it and flashes ⌘C in the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制任意内容 — Pastel it！ 会保存并在菜单栏闪烁 ⌘C。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何でもコピー — Pastel it！ が保存し、メニューバーで ⌘C を点滅させます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez n'importe quoi — Pastel it！ l'enregistre et affiche ⌘C dans la barre de menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles kopieren — Pastel it！ speichert es und blinkt ⌘C in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia cualquier cosa — Pastel it！ la guarda y muestra ⌘C en la barra de menús."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuj cokolwiek — Pastel it！ zapisuje i miga ⌘C na pasku menu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製任何內容 — Pastel it！ 會保存，並在選單列閃爍 ⌘C。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 복사하세요. Pastel it！이 저장하고 메뉴 막대에서 ⌘C를 깜빡입니다."
          }
        }
      }
    },
    "onboarding.paste.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C opens history. Select a clip, then copy or paste it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C 打开剪贴板，选中记录后复制或直接粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘Cで履歴を開き、項目をコピーまたはペーストします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C öffnet den Verlauf. Ein Element auswählen und kopieren oder einfügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C ouvre l’historique. Sélectionnez un élément à copier ou coller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C abre el historial. Selecciona un elemento para copiar o pegar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C otwiera historię. Wybierz element do skopiowania lub wklejenia."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C 開啟剪貼簿，選取記錄後複製或直接貼上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C로 기록을 열고 항목을 복사하거나 붙여넣습니다."
          }
        }
      }
    },
    "onboarding.browse.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Space to preview above the timeline. Click the text to edit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按空格键在时间线上方预览。点击文本可编辑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースでタイムライン上にプレビュー。テキストをクリックして編集。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Espace pour prévisualiser au-dessus de l'historique. Cliquez le texte pour modifier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leertaste für die Vorschau über dem Verlauf. Text anklicken zum Bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Espacio para previsualizar sobre el historial. Haz clic en el texto para editar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij Spację, aby podejrzeć nad historią. Kliknij tekst, aby edytować."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按空白鍵可在時間軸上方預覽。點一下文字即可編輯。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 눌러 타임라인 위에서 미리봅니다. 텍스트를 클릭해 편집하세요."
          }
        }
      }
    },
    "onboarding.organize.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-click several clips, then press Return to paste them in order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-点击多个剪贴项，然后按 Return 按顺序粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-クリックで複数選択し、Return で順にペースト。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-cliquez plusieurs éléments, puis Entrée pour les coller dans l'ordre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-Klick auf mehrere Einträge, dann Eingabe zum Einfügen in Reihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-clic en varios elementos, luego Intro para pegarlos en orden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-kliknij kilka elementów, potem Return, aby wkleić w kolejności."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-點選多個項目，再按 Return 依序貼上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-클릭으로 여러 항목을 고른 뒤 Return으로 순서대로 붙여넣습니다."
          }
        }
      }
    },
    "onboarding.stack.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C opens a queue on the right. Copy several things, then ⌘V in the target app to paste them one by one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C 在右侧打开队列。复制多项后，在目标应用中按 ⌘V 逐一粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C で右にキューを開く。複数コピー後、対象アプリで ⌘V を押して順にペースト。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C ouvre une file à droite. Copiez plusieurs éléments, puis ⌘V dans l'app cible un par un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C öffnet eine Warteschlange rechts. Mehrere Dinge kopieren, dann ⌘V in der Ziel-App nacheinander."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C abre una cola a la derecha. Copia varias cosas, luego ⌘V en la app destino una a una."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C otwiera kolejkę po prawej. Skopiuj kilka rzeczy, potem ⌘V w docelowej aplikacji po kolei."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C 會在右側打開佇列。複製多項內容後，在目標 App 中按 ⌘V 逐一貼上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C로 오른쪽에 대기열을 엽니다. 여러 항목을 복사한 뒤 대상 App에서 ⌘V로 하나씩 붙여넣으세요."
          }
        }
      }
    },
