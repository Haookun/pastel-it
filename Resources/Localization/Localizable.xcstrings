    "privacy.logs.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usage information is collected or uploaded. Diagnostic logs are stored only on this Mac and never contain clipboard contents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不收集或上传使用信息。诊断日志仅保存在本机，不包含剪贴板内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用情報の収集・送信は行いません。診断ログはこのMacにのみ保存され、クリップボードの内容を含みません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune information d’utilisation n’est collectée ni envoyée. Les journaux restent sur ce Mac et ne contiennent pas le presse-papiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzungsdaten werden weder erfasst noch übertragen. Diagnoseprotokolle bleiben auf diesem Mac und enthalten keine Zwischenablage-Inhalte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se recopila ni envía información de uso. Los registros permanecen en este Mac y no contienen el contenido del portapapeles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane o użytkowaniu nie są zbierane ani wysyłane. Dzienniki pozostają na tym Macu i nie zawierają treści schowka."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不收集或上傳使用資訊。診斷日誌僅儲存在本機，不包含剪貼簿內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 정보를 수집하거나 전송하지 않습니다. 진단 로그는 이 Mac에만 저장되며 클립보드 내용을 포함하지 않습니다."
          }
        }
      }
    },
    "privacy.logs.retention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs are kept for at most 14 days, up to about 768 KB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志最多保留14天，总量不超过约768 KB。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログは最大14日間、合計約768 KBまで保存されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservation maximale : 14 jours, environ 768 Ko."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufbewahrung: maximal 14 Tage, insgesamt etwa 768 KB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan hasta 14 días, con un total de unos 768 KB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzienniki są przechowywane do 14 dni, łącznie około 768 KB."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌最多保留14天，總量不超過約768 KB。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그는 최대 14일, 총 약 768 KB까지 보관합니다."
          }
        }
      }
    },
