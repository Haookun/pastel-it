    "candidatePlacement.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility lets Pastel it！ place the candidate bar next to your text cursor. Without it, the bar appears near the mouse pointer instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权后可在输入光标旁显示候选列表；无法定位时在鼠标旁显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權後可在文字游標旁顯示候選清單；無法定位時在滑鼠旁顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限を許可すると文字カーソル付近に表示します。位置を取得できない場合はポインタ付近に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한을 허용하면 텍스트 커서 옆에 표시합니다. 위치를 확인할 수 없으면 포인터 근처에 표시합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accessibilité permet un affichage près du curseur de texte, sinon près du pointeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Bedienungshilfen erscheint die Liste am Textcursor, andernfalls am Mauszeiger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilidad permite mostrar la lista junto al cursor; si no está disponible, junto al puntero."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępność pozwala wyświetlać listę przy kursorze tekstowym, a w razie braku pozycji przy wskaźniku."
          }
        }
      }
    },
