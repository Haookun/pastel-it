    "removal.confirmCount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld clips will be permanently deleted. This cannot be undone and ends removal undo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将永久删除 %lld 项。此操作无法撤销，并会结束之前的移除撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件を完全に削除します。この操作と以前の項目の削除を取り消せなくなります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments seront supprimés définitivement. Cette action est irréversible et met fin à l’annulation des retraits précédents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Einträge werden endgültig gelöscht. Dies ist nicht rückgängig zu machen und beendet das Rückgängigmachen vorheriger Entfernungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán permanentemente %lld elementos. No se puede deshacer y finaliza la opción de deshacer retiradas anteriores."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba elementów do trwałego usunięcia: %lld. Nie można tego cofnąć; kończy to też możliwość cofnięcia wcześniejszych usunięć."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將永久刪除 %lld 項。此操作無法還原，並會結束先前的移除還原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목을 영구 삭제합니다. 이 작업은 실행 취소할 수 없으며 이전 제거의 실행 취소도 종료됩니다."
          }
        }
      }
    },
    "removal.keepSaved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned clips and clips in folders will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "置顶和文件夹中的内容将保留。"
          }
        },
        "ja": {
