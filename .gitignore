# Swift Package Manager
.build/
.swiftpm/

# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
xcuserdata/
DerivedData/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
*.swp
*~
.idea/
.vscode/
.cursor/

# Sparkle release archives (DMGs for generate_appcast); do not commit binaries
updates/*
!updates/.gitkeep
*.dmg

# Release packaging output
dist/

# Local analytics credentials (never commit)
Secrets/posthog.env

# Pinned Sparkle tools (auto-downloaded by scripts/generate-appcast.sh)
.tools/


# Local repair dependencies, evidence and backups
work/

__pycache__/

# Optional artwork tooling
.venv-artwork/

# Intermediate raster inputs; SVG and formal icon resources are committed
design/layers/*-trace-input.png
